# Production candidate for Unsloth Qwen3.8-27B GGUF on both RTX A4000 GPUs.
# The model is intentionally isolated from the existing Qwen3.5 vLLM runtime.
QWEN38_CUDA_VISIBLE_DEVICES=1,2
QWEN38_MODEL=/srv/brmmedia/models/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q4_K_XL.gguf
QWEN38_SERVED_MODEL_NAME=qwen38-27b-ud-q4-xl
QWEN38_HOST=127.0.0.1
QWEN38_PORT=8001
QWEN38_CONTEXT_SIZE=4096
QWEN38_PARALLEL=1
QWEN38_SPLIT_MODE=layer
QWEN38_TENSOR_SPLIT=1,1
QWEN38_FLASH_ATTN=auto
QWEN38_GPU_LAYERS=all
QWEN38_BIN=/srv/brmmedia/qwen38-llama/bin/llama-server
QWEN38_LOG_LEVEL=info
