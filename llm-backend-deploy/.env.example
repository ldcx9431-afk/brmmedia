# Qwen3.6 27B vLLM service for the second RTX A5000.

# This server's GPU0 is the RTX A5000 (24 GB); keep ComfyUI on GPU1.
QWEN_CUDA_VISIBLE_DEVICES=0

# A5000 24GB friendly vLLM quantized checkpoint.
# The base BF16/FP8 checkpoints are not the right default for a single A5000.
QWEN_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
QWEN_SERVED_MODEL_NAME=qwen

# If this local directory exists, start_qwen_vllm.sh will use it instead of
# downloading/loading from Hugging Face.
QWEN_PREFER_LOCAL_MODEL=true
QWEN_LOCAL_MODEL_DIR=./models/Qwen3.6-35B-A3B-AWQ-4bit

QWEN_HOST=127.0.0.1
QWEN_PORT=8000

QWEN_TENSOR_PARALLEL_SIZE=1
# Conservative first-run values for a single 24 GB A5000. Raise only after load tests.
QWEN_GPU_MEMORY_UTILIZATION=0.88
QWEN_MAX_MODEL_LEN=16384
QWEN_MAX_NUM_SEQS=2
QWEN_MAX_NUM_BATCHED_TOKENS=4096

# Qwen reasoning parser for OpenAI-compatible responses.
QWEN_REASONING_PARSER=qwen3

# MTP/speculative decoding may improve throughput when the checkpoint includes
# compatible MTP weights. Keep disabled until the basic server is stable.
QWEN_ENABLE_MTP=false
QWEN_SPECULATIVE_TOKENS=2

# Extra vLLM args can be appended here.
QWEN_EXTRA_ARGS=--enable-prefix-caching --quantization awq

HF_HOME=/opt/baorongwanxiang/llm-backend-deploy/.cache/huggingface
VLLM_LOGGING_LEVEL=INFO
