# Safe BRMMedia default: keep all ComfyUI media workflows on GPU0/A5000 and
# Qwen on GPU1/A4000.  This matches .env.qwen35-4b.example and the production
# systemd verification profile.
QWEN_CUDA_VISIBLE_DEVICES=1
QWEN_MODEL=cyankiwi/Qwen3.5-4B-AWQ-4bit
QWEN_SERVED_MODEL_NAME=qwen35-4b-awq

# If this local directory exists, start_qwen_vllm.sh will use it instead of
# downloading/loading from Hugging Face.
QWEN_PREFER_LOCAL_MODEL=true
QWEN_LOCAL_MODEL_DIR=/srv/brmmedia/models/Qwen3.5-4B-AWQ-4bit

QWEN_HOST=127.0.0.1
QWEN_PORT=8000

QWEN_TENSOR_PARALLEL_SIZE=1
# Conservative A4000 values. Do not raise these before stability burn-in.
QWEN_GPU_MEMORY_UTILIZATION=0.70
QWEN_MAX_MODEL_LEN=4096
QWEN_MAX_NUM_SEQS=1
QWEN_MAX_NUM_BATCHED_TOKENS=2048

# Qwen reasoning parser for OpenAI-compatible responses.
QWEN_REASONING_PARSER=qwen3

# MTP/speculative decoding may improve throughput when the checkpoint includes
# compatible MTP weights. Keep disabled until the basic server is stable.
QWEN_ENABLE_MTP=false
QWEN_SPECULATIVE_TOKENS=2

# Extra vLLM args can be appended here.
QWEN_EXTRA_ARGS="--enforce-eager"

HF_HOME=/srv/brmmedia/app/llm-backend-deploy/.cache/huggingface
VLLM_LOGGING_LEVEL=INFO
VLLM_USE_FLASHINFER_SAMPLER=0
