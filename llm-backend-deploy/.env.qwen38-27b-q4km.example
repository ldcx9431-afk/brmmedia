# Validated production profile for Qwen3.8-27B on two RTX A4000 GPUs.
# UD-Q4_K_XL is retained as a candidate file but is not selected here because
# its Dynamic V3 loader did not reach an API-ready state on llama.cpp.
QWEN38_CUDA_VISIBLE_DEVICES=1,2
QWEN38_MODEL=/srv/brmmedia/models/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q4_K_M.gguf
QWEN38_SERVED_MODEL_NAME=qwen38-27b-ud-q4-k-m
QWEN38_HOST=127.0.0.1
QWEN38_PORT=8001
QWEN38_CONTEXT_SIZE=140288
QWEN38_PARALLEL=1
QWEN38_SPLIT_MODE=layer
QWEN38_TENSOR_SPLIT=1,1
QWEN38_FLASH_ATTN=auto
QWEN38_CACHE_TYPE_K=q8_0
QWEN38_CACHE_TYPE_V=q8_0
QWEN38_GPU_LAYERS=all
QWEN38_BIN=/srv/brmmedia/qwen38-llama/bin/llama-server
QWEN38_LOG_LEVEL=info
# Validated image input; keep the visual encoder on CPU with the 140288 context.
QWEN38_MMPROJ=/srv/brmmedia/models/Qwen3.8-27B-GGUF/mmproj-F16.gguf
QWEN38_MMPROJ_SHA256=cbb841a9ee0636b2ec172f5bb8df2ea8dfeb01e90fe7c6126581d662a0b4e43e
QWEN38_MMPROJ_OFFLOAD=0
QWEN38_IMAGE_MAX_TOKENS=1024
