# Validated production profile for Qwen3.8-27B on two RTX A4000 GPUs.
# UD-Q4_K_XL is retained as a candidate file but is not selected here because
# its Dynamic V3 loader did not reach an API-ready state on llama.cpp.
QWEN38_CUDA_VISIBLE_DEVICES=1,2
QWEN38_MODEL=/srv/brmmedia/models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
QWEN38_SERVED_MODEL_NAME=qwen38-27b-q4-k-m
QWEN38_HOST=127.0.0.1
QWEN38_PORT=8001
QWEN38_CONTEXT_SIZE=4096
QWEN38_PARALLEL=1
QWEN38_SPLIT_MODE=layer
QWEN38_TENSOR_SPLIT=1,1
QWEN38_FLASH_ATTN=auto
QWEN38_GPU_LAYERS=all
QWEN38_BIN=/srv/brmmedia/qwen38-llama/bin/llama-server
QWEN38_LOG_LEVEL=info
