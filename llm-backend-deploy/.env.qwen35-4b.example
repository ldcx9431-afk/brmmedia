# Independent test configuration for cyankiwi/Qwen3.5-4B-AWQ-4bit.
# Keep the default .env for the original Qwen3.6 deployment unchanged.

# GPU1 is RTX A4000 16 GB; all ComfyUI media workflows use GPU0/A5000.
QWEN_CUDA_VISIBLE_DEVICES=1
QWEN_MODEL=cyankiwi/Qwen3.5-4B-AWQ-4bit
QWEN_SERVED_MODEL_NAME=qwen35-4b-awq
QWEN_PREFER_LOCAL_MODEL=true
QWEN_LOCAL_MODEL_DIR=/srv/brmmedia/models/Qwen3.5-4B-AWQ-4bit

# Keep the service local until authenticated Nginx access is configured.
QWEN_HOST=127.0.0.1
QWEN_PORT=8000
QWEN_TENSOR_PARALLEL_SIZE=1
# Conservative test limits: leave VRAM headroom for the Windows/WSL host and
# only raise these after a stable burn-in test.
QWEN_GPU_MEMORY_UTILIZATION=0.70
QWEN_MAX_MODEL_LEN=4096
QWEN_MAX_NUM_SEQS=1
QWEN_MAX_NUM_BATCHED_TOKENS=2048
QWEN_REASONING_PARSER=qwen3
QWEN_ENABLE_MTP=false
# This repository declares its own `compressed-tensors` quantization in
# config.json. Do not override it with `--quantization awq`.  For the
# stability-first WSL test profile, also skip torch.compile/CUDA Graphs.
QWEN_EXTRA_ARGS="--enforce-eager"

# Qwen3.5 needs a current vLLM build.  Set these before invoking
# install_qwen_vllm.sh when the server has network access, or stage wheels offline.
# VLLM_PIP_SPEC=vllm==0.26.0
# VLLM_EXTRA_INDEX_URL=https://wheels.vllm.ai/nightly
HF_HOME=/srv/brmmedia/app/llm-backend-deploy/.cache/huggingface
VLLM_LOGGING_LEVEL=INFO

# WSL runtime has the CUDA driver but intentionally no nvcc toolkit.  Use
# vLLM's PyTorch-native sampler instead of FlashInfer's JIT sampler.
VLLM_USE_FLASHINFER_SAMPLER=0
