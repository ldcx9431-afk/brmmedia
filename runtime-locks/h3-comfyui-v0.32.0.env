# Reviewed MiniMax H3 candidate runtime.  This file is shell sourced only by
# repository deployment scripts; keep values literal and do not add commands.
#
# ComfyUI v0.32.0 tag resolves to this immutable commit.  Pinning both the
# human-readable tag and commit prevents a retag or a moving branch from
# silently changing a benchmark candidate.
BRMMEDIA_H3_COMFYUI_VERSION=0.32.0
BRMMEDIA_H3_COMFYUI_TAG=v0.32.0
BRMMEDIA_H3_COMFYUI_REF=c2bcbecd82ec5ae66594340b395c24ef0217b238

# CUDA 13 candidate package set.  SageAttention is built from the official
# v2.2.0 source commit in prepare_h3_cuda13_sage_candidate.sh unless a reviewed
# wheel URL is explicitly supplied by the operator.
BRMMEDIA_H3_TORCH_VERSION=2.11.0
BRMMEDIA_H3_TORCHVISION_VERSION=0.26.0
BRMMEDIA_H3_TORCHAUDIO_VERSION=2.11.0
BRMMEDIA_H3_TORCH_INDEX=https://download.pytorch.org/whl/cu130
BRMMEDIA_H3_SAGE_SOURCE_COMMIT=eb615cf6cf4d221338033340ee2de1c37fbdba4a

# v0.32.0 requirements pin comfy-kitchen to this version.  The runtime gate
# verifies it before allowing the --use-ck-attention A/B candidate to start.
BRMMEDIA_H3_COMFY_KITCHEN_VERSION=0.2.30
