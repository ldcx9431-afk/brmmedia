[Unit]
Description=BRMMedia IndexTTS-2.5 isolated loopback service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/opt/baorongwanxiang/ubuntu-backend-deploy
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/baorongwanxiang/ubuntu-backend-deploy/start_indextts25.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
