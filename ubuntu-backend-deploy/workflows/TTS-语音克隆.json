      "max_tokens_per_sentence": 120,
      "seed": 0,
      "cache_control": null
    }
  },
  "3": {
    "class_type": "SaveAudioMP3",
    "inputs": {
      "audio": ["2", 0],
      "filename_prefix": "IndexTTS2",
      "quality": "320k"
    }
  }
}
