[Unit]
Description=Qwen Image 2.1 isolated non-commercial research runtime
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/brmmedia/qwen-image21/ComfyUI
Environment=CUDA_VISIBLE_DEVICES=0
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=8
ExecStart=/srv/brmmedia/qwen-image21/venv/bin/python main.py --listen 127.0.0.1 --port 8190 --extra-model-paths-config /srv/brmmedia/qwen-image21/extra_models.yaml --disable-all-custom-nodes --offline --cache-none --reserve-vram 2
Restart=on-failure
RestartSec=10
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
