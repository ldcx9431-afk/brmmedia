map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      "";
}

upstream brmmedia_gradio {
    server 127.0.0.1:9000;
    keepalive 32;
}

upstream brmmedia_lan_api {
    server 127.0.0.1:9100;
    keepalive 32;
}

upstream brmmedia_comfyui {
    server 127.0.0.1:8188;
    keepalive 32;
}

upstream brmmedia_strata {
    server 127.0.0.1:8002;
    keepalive 32;
}

upstream brmmedia_qwen_gateway {
    server 127.0.0.1:9300;
    keepalive 32;
}

server {
    listen 80;
    server_name _;

    auth_basic "BRMMedia testing";
    auth_basic_user_file /etc/nginx/.htpasswd-brmmedia;

    # Zero-copy internal static artifact exit for X-Accel-Redirect
    location /internal-outputs/ {
        internal;
        auth_basic off;
        alias /mnt/d/brmmedia/outputs/;
        sendfile on;
        aio threads;
    }

    # Expose the active local Qwen/Strata engine through the authenticated LAN entry.
    location = /qwen {
        return 308 /qwen/v1/;
    }
    include /etc/nginx/snippets/brmmedia-qwen-upstream.conf;
    include /etc/nginx/snippets/brmmedia-qwen-api-gateway.conf;

    # Stable REST contract for LAN automation.  The process itself is bound to
    # 127.0.0.1:9100; this authenticated reverse proxy is the only LAN entry.
    location /api/ {
        auth_basic off;
        proxy_pass http://brmmedia_lan_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3700s;
        proxy_send_timeout 3700s;
        client_max_body_size 2100M;
    }

    # Native ComfyUI workflow management.  It remains loopback-only on 8188;
    # this authenticated proxy is the sole LAN path and preserves WebSocket
    # traffic needed for execution progress.
    location = /comfyui {
        return 308 /comfyui/;
    }

    location /comfyui/ {
        proxy_pass http://brmmedia_comfyui/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /comfyui;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3700s;
        proxy_send_timeout 3700s;
        proxy_buffering off;
        client_max_body_size 2G;
    }

    include /etc/nginx/snippets/brmmedia-model-lab.conf;

    location / {
        proxy_pass http://brmmedia_gradio;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3700s;
        proxy_send_timeout 3700s;
        client_max_body_size 2G;
    }
}
