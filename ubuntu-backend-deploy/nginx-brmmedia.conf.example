server {
    listen 80;
    server_name _;

    auth_basic "BRMMedia testing";
    auth_basic_user_file /etc/nginx/.htpasswd-brmmedia;

    # Expose the loopback-only vLLM API through the authenticated LAN entry.
    # /qwen/v1/models is proxied to http://127.0.0.1:8000/v1/models.
    location = /qwen {
        return 308 /qwen/v1/;
    }

    location /qwen/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3700s;
        proxy_send_timeout 3700s;
        proxy_buffering off;
        client_max_body_size 32M;
    }

    # Stable REST contract for LAN automation.  The process itself is bound to
    # 127.0.0.1:9100; this authenticated reverse proxy is the only LAN entry.
    location /api/ {
        proxy_pass http://127.0.0.1:9100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3700s;
        proxy_send_timeout 3700s;
        client_max_body_size 256M;
    }

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3700s;
        proxy_send_timeout 3700s;
        client_max_body_size 2G;
    }
}
