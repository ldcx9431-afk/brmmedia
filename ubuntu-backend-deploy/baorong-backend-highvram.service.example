[Unit]
Description=Bao Rong Wan Xiang high-VRAM Gradio and ComfyUI backend
After=network-online.target
Wants=network-online.target
Conflicts=baorong-backend.service qwen-vllm.service
StartLimitIntervalSec=2min
StartLimitBurst=6

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/opt/baorongwanxiang/ubuntu-backend-deploy
ExecStart=/opt/baorongwanxiang/ubuntu-backend-deploy/start_backend.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
Environment=PYTHONUNBUFFERED=1
Environment=BRM_PROFILE=highvram

[Install]
WantedBy=multi-user.target
