# Copy this file to .env and adjust paths before starting.

# ComfyUI checkout on Ubuntu. The install script creates ./ComfyUI by default.
COMFYUI_ROOT=/opt/baorongwanxiang/ComfyUI

# Python interpreter used to start ComfyUI.
# Usually this is the same backend venv python.
COMFYUI_PYTHON=/opt/baorongwanxiang/ubuntu-backend-deploy/.venv/bin/python

# ComfyUI bind address and port.
# Use 127.0.0.1 behind a reverse proxy, or 0.0.0.0 for LAN access.
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# Pin Gradio to loopback; Nginx is the only LAN-facing service.
BRM_GRADIO_HOST=127.0.0.1
BRM_GRADIO_PORT=9000
# Leave empty when Nginx serves this app at the site root.
BRM_GRADIO_ROOT_PATH=

# All ComfyUI media workflows are fixed to RTX A5000 (GPU0, 24 GB).
# Qwen vLLM is independently fixed to RTX A4000 (GPU1) in its own .env.
COMFYUI_CUDA_VISIBLE_DEVICES=0

# Keep LTX2.3 available until native H3 models, ComfyUI and smoke tests pass.
# The production cutover explicitly changes this to h3.
BRMMEDIA_VIDEO_ENGINE=ltx23

# Optional extra ComfyUI arguments.
# Keep empty during the CUDA/Sage baseline.  MiniMax H3 must not use
# --highvram, --gpu-only, --disable-smart-memory or --cache-none because its
# Qwen3-VL encoder is loaded on demand.  --fast-disk is a separate A/B option
# and may only be enabled after the candidate benchmark records an improvement.
COMFYUI_ARGS=

# Performance profile: balanced only for the shared A5000 media queue.
BRM_PERF_PROFILE=balanced

# CUDA/PyTorch runtime tuning. Keep these unless a specific model/node requires otherwise.
PYTORCH_CUDA_ALLOC_CONF=backend:cudaMallocAsync,expandable_segments:True
CUDA_MODULE_LOADING=LAZY
NVIDIA_TF32_OVERRIDE=1
TORCH_ALLOW_TF32_CUBLAS_OVERRIDE=1

# Cache directories kept inside this deployment tree for easier backup/migration.
HF_HOME=/opt/baorongwanxiang/ubuntu-backend-deploy/.cache/huggingface
TORCH_HOME=/opt/baorongwanxiang/ubuntu-backend-deploy/.cache/torch

# Timeouts in seconds.
COMFYUI_STARTUP_TIMEOUT=300
COMFYUI_TASK_TIMEOUT=3600
# Only MiniMax H3 gets this longer wait budget.  On expiry the backend sends a
# ComfyUI interrupt, so a stale task cannot keep the A5000 queue occupied.
BRM_H3_TASK_TIMEOUT=14400

# 拒绝新任务前必须保留的最小产物磁盘空间百分比；不会自动删除素材。
BRM_MIN_FREE_DISK_PERCENT=10
