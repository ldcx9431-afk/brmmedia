[Unit]
Description=BRMMedia ZONOS3-Mini Mandarin and voice cloning
After=network.target

[Service]
Type=simple
User=brm
Group=brm
WorkingDirectory=/srv/brmmedia/zonos3-mini
Environment=OMP_NUM_THREADS=4
Environment=ZAC_THREADS=4
CPUQuota=2400%
Nice=5
MemoryMax=10G
MemorySwapMax=0
OOMScoreAdjust=100
UMask=0077
ExecStart=/srv/brmmedia/zonos3-mini/build-cpu-openblas/zonos3-server /srv/brmmedia/models/zonos/backbone-ptq.gguf --host 127.0.0.1 --port 1919 --cpu --batch 4 --zac-threads 4 --zac /srv/brmmedia/models/zonos/zac-keep2.gguf --spk-encoder /srv/brmmedia/models/zonos/spk-encoder.gguf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
