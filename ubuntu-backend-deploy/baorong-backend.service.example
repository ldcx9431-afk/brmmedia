[Unit]
Description=Bao Rong Wan Xiang Gradio and ComfyUI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/opt/baorongwanxiang/ubuntu-backend-deploy
ExecStart=/opt/baorongwanxiang/ubuntu-backend-deploy/start_backend.sh
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
